# Spring 백엔드 API base url (서버사이드 프록시용)
API_BASE_URL=https://api.bdink.co.kr

# 클라이언트에서 직접 호출할 때 쓰는 public base url
NEXT_PUBLIC_API_BASE_URL=https://api.bdink.co.kr

# 카카오 개발자센터 > 플랫폼 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=

# 결제 PG (포트원/토스 중 선택)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# CloudFront 서명 URL 관련 (서버 전용, 절대 노출 금지)
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
